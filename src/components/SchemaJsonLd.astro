---
import { useTranslations, getLocalizedPath, type Locale } from '../i18n/ui';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const pageUrl = new URL(getLocalizedPath(lang, ''), 'https://giftomp4.github.io').toString();

const schemaGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      '@id': `${pageUrl}#webapp`,
      name: 'GIFtoMP4',
      url: 'https://giftomp4.github.io/',
      inLanguage: lang,
      applicationCategory: 'MultimediaApplication',
      operatingSystem: 'All',
      browserRequirements: 'Requires HTML5 and WebAssembly support',
      description: t('site.description'),
      offers: {
        '@type': 'Offer',
        price: '0.00',
        priceCurrency: 'USD',
      },
    },
    {
      '@type': 'HowTo',
      '@id': `${pageUrl}#howto`,
      name: t('howto.name'),
      description: t('hero.subtitle'),
      totalTime: 'PT5S',
      step: [
        {
          '@type': 'HowToStep',
          position: 1,
          name: t('howto.step1.title'),
          text: t('howto.step1.text'),
          url: `${pageUrl}#step-1-dropzone`,
        },
        {
          '@type': 'HowToStep',
          position: 2,
          name: t('howto.step2.title'),
          text: t('howto.step2.text'),
          url: `${pageUrl}#step-2-controls`,
        },
        {
          '@type': 'HowToStep',
          position: 3,
          name: t('howto.step3.title'),
          text: t('howto.step3.text'),
          url: `${pageUrl}#step-4-result`,
        },
      ],
    },
    {
      '@type': 'FAQPage',
      '@id': `${pageUrl}#faq`,
      mainEntity: [
        {
          '@type': 'Question',
          name: t('faq.q1'),
          acceptedAnswer: {
            '@type': 'Answer',
            text: t('faq.a1'),
          },
        },
        {
          '@type': 'Question',
          name: t('faq.q2'),
          acceptedAnswer: {
            '@type': 'Answer',
            text: t('faq.a2'),
          },
        },
        {
          '@type': 'Question',
          name: t('faq.q3'),
          acceptedAnswer: {
            '@type': 'Answer',
            text: t('faq.a3'),
          },
        },
        {
          '@type': 'Question',
          name: t('faq.q4'),
          acceptedAnswer: {
            '@type': 'Answer',
            text: t('faq.a4'),
          },
        },
      ],
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${pageUrl}#breadcrumb`,
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: t('nav.breadcrumb.home'),
          item: 'https://giftomp4.github.io/',
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: t('nav.breadcrumb.tools'),
          item: `${pageUrl}#tools-guide`,
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: t('nav.breadcrumb.converter'),
          item: pageUrl,
        },
      ],
    },
  ],
};
---

<script type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

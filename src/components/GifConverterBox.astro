          <button
            type="button"
            id="reconvert-btn"
            aria-label={t('controls.reconvert')}
            class="px-4 py-2 rounded-xl text-xs sm:text-sm font-extrabold bg-white dark:bg-[#182B4E] text-[#166BF3] dark:text-[#ECB051] border-2 border-[#166BF3] dark:border-[#ECB051] hover:scale-105 transition-transform flex items-center gap-1.5"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="3" />
              <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z" />
            </svg>
            <span>{t('controls.reconvert')}</span>
          </button>
        </div>

        <!-- Live Video / Image Preview Player + Download CTA -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-center">
          <!-- Preview Container -->
          <div class="lg:col-span-7 bg-[#0B1528] rounded-2xl overflow-hidden border-2 border-[#166BF3] dark:border-[#ECB051] flex items-center justify-center min-h-[240px] max-h-[360px] relative shadow-inner">
            <video
              id="output-video-preview"
              controls
              autoplay
              loop
              muted
              playsinline
              aria-label="Converted MP4 Video Preview"
              class="w-full max-h-[340px] object-contain"
            ></video>
            <img
              id="output-image-preview"
              alt="Converted output preview"
              class="hidden w-full max-h-[340px] object-contain"

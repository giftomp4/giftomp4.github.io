        <div class="flex flex-col md:flex-row items-center justify-between gap-4 pb-5 mb-5 border-b-2 border-[#166BF3]/25 dark:border-[#ECB051]/25">
          <div class="flex items-center gap-3">
            <div class="w-12 h-12 rounded-2xl bg-[#166BF3] dark:bg-[#ECB051] text-white dark:text-[#0B1528] flex items-center justify-center font-black text-xl shrink-0 shadow">
              ✓
            </div>
            <div>
              <span class="inline-block text-xs font-extrabold uppercase tracking-wider px-2.5 py-0.5 rounded-full bg-[#ECB051] text-[#0B1528] mb-1">
                {t('result.readyBadge')}

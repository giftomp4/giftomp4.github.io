---
import { useTranslations, type Locale } from '../i18n/ui';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section
  aria-label={t('hero.h1')}
  class="w-full max-w-4xl mx-auto px-3 sm:px-6 pt-3 pb-8 md:py-6 flex flex-col justify-center min-h-[calc(100dvh-4.5rem)]"
>
  <!-- Primary H1 & Concise Subtitle -->
  <div class="text-center mb-4 md:mb-5">
    <h1 class="hero-heading font-extrabold text-[#0B1528] dark:text-[#E1E8F4] tracking-tight mb-2">
      {t('hero.h1')}
    </h1>
    <p class="text-base sm:text-lg md:text-[1.12rem] font-medium text-[#0B1528]/85 dark:text-[#E1E8F4]/85 max-w-2xl mx-auto leading-relaxed">
      {t('hero.subtitle')}
    </p>
  </div>

  <!-- Interactive Converter Box Div -->
  <div
    id="converter-workspace-box"
    class="workspace-box rounded-3xl shadow-workspace p-4 sm:p-6 md:p-7 relative overflow-hidden transition-all duration-300"
  >
    <!-- Top Header Bar: Active Mode Collapsible Trigger + 3-Step Indicator -->
    <div class="flex flex-wrap items-center justify-between gap-3 pb-3.5 mb-4 border-b-2 border-[#E1E8F4] dark:border-[#13223E]">
      <!-- Collapsible Mode / Preset Selector Button with Rotating Arrow Icon -->
      <button
        type="button"
        id="toggle-mode-drawer-btn"
        aria-expanded="false"
        aria-controls="mode-drawer-content"
        class="px-4 py-2 rounded-2xl bg-[#166BF3] text-white dark:bg-[#ECB051] dark:text-[#0B1528] font-extrabold text-sm sm:text-base shadow-md hover:opacity-95 transition-all flex items-center gap-2.5 border-2 border-[#ECB051] dark:border-[#166BF3]"
      >
        <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="2" y="3" width="20" height="18" rx="3" />
          <polygon points="10 8 16 12 10 16 10 8" fill="currentColor" />
        </svg>
        <span id="active-mode-label">{t('mode.gifToMp4')}</span>
        <svg
          id="mode-drawer-arrow"
          class="w-4 h-4 transition-transform duration-200 shrink-0"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <polyline points="6 9 12 15 18 9" />
        </svg>
      </button>

      <!-- Minimal 3-Step Wizard Indicator -->
      <div class="flex items-center gap-1.5 sm:gap-2.5 text-xs sm:text-sm font-extrabold select-none">
        <div id="wizard-dot-1" class="flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#166BF3] text-white dark:bg-[#ECB051] dark:text-[#0B1528] shadow-sm transition-all">
          <span class="w-4 h-4 rounded-full bg-white/25 dark:bg-[#0B1528]/20 flex items-center justify-center text-[11px]">1</span>
          <span>Select GIF</span>
        </div>
        <svg class="w-3.5 h-3.5 text-[#166BF3]/50 dark:text-[#ECB051]/50" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="9 18 15 12 9 6" />
        </svg>
        <div id="wizard-dot-2" class="flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#E1E8F4] dark:bg-[#13223E] text-[#0B1528]/60 dark:text-[#E1E8F4]/60 transition-all">
          <span class="w-4 h-4 rounded-full bg-[#0B1528]/10 dark:bg-white/10 flex items-center justify-center text-[11px]">2</span>
          <span>Convert</span>
        </div>
        <svg class="w-3.5 h-3.5 text-[#166BF3]/50 dark:text-[#ECB051]/50" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="9 18 15 12 9 6" />
        </svg>
        <div id="wizard-dot-3" class="flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#E1E8F4] dark:bg-[#13223E] text-[#0B1528]/60 dark:text-[#E1E8F4]/60 transition-all">
          <span class="w-4 h-4 rounded-full bg-[#0B1528]/10 dark:bg-white/10 flex items-center justify-center text-[11px]">3</span>
          <span>Download</span>
        </div>
      </div>
    </div>

    <!-- COLLAPSIBLE MODE / FORMAT DRAWER (Hidden by default; shows all 6 modes in a full visible grid when expanded) -->
    <div
      id="mode-drawer-content"
      role="tablist"
      aria-label="Conversion Modes"
      class="hidden mb-5 p-3.5 rounded-2xl bg-[#E1E8F4]/55 dark:bg-[#13223E]/90 border-2 border-[#166BF3]/30 dark:border-[#ECB051]/40 grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-2.5 transition-all"
    >
      <button
        type="button"
        role="tab"
        aria-selected="true"
        aria-label={t('mode.gifToMp4')}
        data-mode="gif-to-mp4"
        class="mode-pill w-full px-4 py-2.5 rounded-xl font-extrabold text-sm transition-all bg-[#166BF3] text-white dark:bg-[#ECB051] dark:text-[#0B1528] shadow-sm flex items-center gap-2.5 text-left"
      >
        <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="2" y="3" width="20" height="18" rx="3" />
          <polygon points="10 8 16 12 10 16 10 8" fill="currentColor" />
        </svg>
        <span class="truncate">{t('mode.gifToMp4')}</span>
      </button>

      <button
        type="button"
        role="tab"
        aria-selected="false"
        aria-label={t('mode.gifToVideo')}
        data-mode="gif-to-video"
        class="mode-pill w-full px-4 py-2.5 rounded-xl font-bold text-sm transition-all bg-white dark:bg-[#182B4E] text-[#0B1528] dark:text-[#E1E8F4] hover:bg-[#F2E2CA] dark:hover:bg-[#0B1528] flex items-center gap-2.5 text-left"
      >
        <svg class="w-4 h-4 text-[#166BF3] dark:text-[#ECB051] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M23 7l-7 5 7 5V7z" />
          <rect x="1" y="5" width="15" height="14" rx="2" ry="2" />
        </svg>
        <span class="truncate">{t('mode.gifToVideo')}</span>
      </button>

      <button
        type="button"
        role="tab"
        aria-selected="false"
        aria-label={t('mode.gifSocial')}
        data-mode="gif-social"
        class="mode-pill w-full px-4 py-2.5 rounded-xl font-bold text-sm transition-all bg-white dark:bg-[#182B4E] text-[#0B1528] dark:text-[#E1E8F4] hover:bg-[#F2E2CA] dark:hover:bg-[#0B1528] flex items-center gap-2.5 text-left"
      >
        <svg class="w-4 h-4 text-[#166BF3] dark:text-[#ECB051] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="6" y="2" width="12" height="20" rx="3" />
          <line x1="12" y1="18" x2="12.01" y2="18" />
        </svg>
        <span class="truncate">{t('mode.gifSocial')}</span>
      </button>

      <button
        type="button"
        role="tab"
        aria-selected="false"
        aria-label={t('mode.mp4ToGif')}
        data-mode="mp4-to-gif"
        class="mode-pill w-full px-4 py-2.5 rounded-xl font-bold text-sm transition-all bg-white dark:bg-[#182B4E] text-[#0B1528] dark:text-[#E1E8F4] hover:bg-[#F2E2CA] dark:hover:bg-[#0B1528] flex items-center gap-2.5 text-left"
      >
        <svg class="w-4 h-4 text-[#166BF3] dark:text-[#ECB051] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="17 1 21 5 17 9" />
          <path d="M3 11V9a4 4 0 0 1 4-4h14" />
          <polyline points="7 23 3 19 7 15" />
          <path d="M21 13v2a4 4 0 0 1-4 4H3" />
        </svg>
        <span class="truncate">{t('mode.mp4ToGif')}</span>
      </button>

      <button
        type="button"
        role="tab"
        aria-selected="false"
        aria-label={t('mode.gifToWebm')}
        data-mode="gif-to-webm"
        class="mode-pill w-full px-4 py-2.5 rounded-xl font-bold text-sm transition-all bg-white dark:bg-[#182B4E] text-[#0B1528] dark:text-[#E1E8F4] hover:bg-[#F2E2CA] dark:hover:bg-[#0B1528] flex items-center gap-2.5 text-left"
      >
        <svg class="w-4 h-4 text-[#166BF3] dark:text-[#ECB051] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="10" />
          <polygon points="10 8 16 12 10 16 10 8" />
        </svg>
        <span class="truncate">{t('mode.gifToWebm')}</span>
      </button>

      <button
        type="button"
        role="tab"
        aria-selected="false"
        aria-label={t('mode.gifToPng')}
        data-mode="gif-to-png"
        class="mode-pill w-full px-4 py-2.5 rounded-xl font-bold text-sm transition-all bg-white dark:bg-[#182B4E] text-[#0B1528] dark:text-[#E1E8F4] hover:bg-[#F2E2CA] dark:hover:bg-[#0B1528] flex items-center gap-2.5 text-left"
      >
        <svg class="w-4 h-4 text-[#166BF3] dark:text-[#ECB051] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="3" width="18" height="18" rx="2" ry="2" />
          <circle cx="8.5" cy="8.5" r="1.5" />
          <polyline points="21 15 16 10 5 21" />
        </svg>
        <span class="truncate">{t('mode.gifToPng')}</span>
      </button>
    </div>

    <!-- ===================================================================== -->
    <!-- SCREEN 1: ULTRA-MINIMAL INITIAL DROPZONE (Main Upload Button Only)    -->
    <!-- ===================================================================== -->
    <div id="screen-1-upload" class="transition-all duration-300">
      <div
        id="step-1-dropzone"
        role="region"
        aria-label={t('drop.title.gif')}
        class="dropzone-area rounded-3xl p-7 sm:p-12 text-center cursor-pointer bg-[#E1E8F4]/35 dark:bg-[#13223E]/60 flex flex-col items-center justify-center relative"
      >
        <input
          type="file"
          id="file-input"
          accept="image/gif,video/mp4,video/webm,video/quicktime"
          multiple
          class="sr-only"
          aria-label={t('drop.cta.gif')}
        />

        <!-- Warm #F2E2CA Accent Badge -->
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-[#F2E2CA] dark:bg-[#13223E] border-2 border-[#ECB051] text-[#0B1528] dark:text-[#ECB051] font-extrabold text-xs sm:text-sm mb-4 shadow-sm">
          <span class="w-2.5 h-2.5 rounded-full bg-[#166BF3] dark:bg-[#ECB051] animate-ping"></span>
          <span>{t('drop.badge')}</span>
        </div>

        <!-- Oversized Floating SVG Icon -->
        <div class="w-20 h-20 rounded-3xl bg-[#166BF3]/10 dark:bg-[#ECB051]/15 border-2 border-[#166BF3] dark:border-[#ECB051] flex items-center justify-center mb-4 animate-float-slow shadow-inner">
          <svg class="w-12 h-12 text-[#166BF3] dark:text-[#ECB051]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
            <polyline points="17 8 12 3 7 8" />
            <line x1="12" y1="3" x2="12" y2="15" />
          </svg>
        </div>

        <h2
          id="dropzone-title"
          data-title-gif={t('drop.title.gif')}
          data-title-mp4={t('drop.title.mp4')}
          class="text-xl sm:text-2xl md:text-3xl font-extrabold text-[#0B1528] dark:text-[#E1E8F4] mb-2"
        >
          {t('drop.title.gif')}
        </h2>

        <p class="text-sm sm:text-base font-medium text-[#0B1528]/75 dark:text-[#E1E8F4]/75 mb-7 max-w-xl">
          {t('drop.subtitle')}
        </p>

        <!-- Single Main Oversized Upload Button (No clutter, no sample button) -->
        <button
          type="button"
          id="select-file-btn"
          aria-label={t('drop.cta.gif')}
          data-cta-gif={t('drop.cta.gif')}
          data-cta-mp4={t('drop.cta.mp4')}
          class="btn-primary-action w-full sm:w-auto min-w-[280px] px-10 py-4 sm:py-5 rounded-2xl font-black text-base sm:text-xl shadow-royal flex items-center justify-center gap-3 border-2 border-[#ECB051]"
        >
          <svg class="w-6 h-6 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
            <polyline points="17 8 12 3 7 8" />
            <line x1="12" y1="3" x2="12" y2="15" />
          </svg>
          <span id="select-file-btn-text">{t('drop.cta.gif')}</span>
        </button>

        <p class="text-xs font-bold text-[#166BF3] dark:text-[#ECB051] mt-4">
          {t('drop.batchHint')}
        </p>
      </div>
    </div>

    <!-- ===================================================================== -->
    <!-- SCREEN 2: FILE LOADED — 1-CLICK CONVERT + COLLAPSIBLE SETTINGS        -->
    <!-- ===================================================================== -->
    <div id="screen-2-ready" class="hidden transition-all duration-300">
      <div id="step-2-controls" class="space-y-4">
        <!-- Focal Card: Selected File Summary + Giant Hero Convert Button Only -->
        <div
          id="selected-file-banner"
          aria-live="polite"
          class="p-6 sm:p-8 rounded-3xl bg-gradient-to-br from-[#F2E2CA]/90 via-[#FFFFFF] to-[#E1E8F4]/70 dark:from-[#13223E] dark:via-[#182B4E] dark:to-[#0B1528] border-2 border-[#166BF3] dark:border-[#ECB051] shadow-md flex flex-col items-center text-center"
        >
          <!-- File Badge & Change File Button Row -->
          <div class="w-full flex flex-wrap items-center justify-between gap-2 pb-4 mb-6 border-b border-[#166BF3]/20 dark:border-[#ECB051]/20">
            <div class="flex items-center gap-3 min-w-0 text-left">
              <div
                id="selected-file-ext-badge"
                class="w-12 h-12 rounded-2xl bg-[#166BF3] text-white dark:bg-[#ECB051] dark:text-[#0B1528] flex items-center justify-center font-black text-sm shrink-0 shadow"
              >
                GIF
              </div>
              <div class="min-w-0">
                <p class="text-xs font-extrabold uppercase tracking-wider text-[#166BF3] dark:text-[#ECB051]">
                  {t('controls.fileSelected')}
                </p>
                <p id="selected-file-name" class="text-base sm:text-lg font-black text-[#0B1528] dark:text-[#E1E8F4] truncate max-w-[220px] sm:max-w-md">
                  animation.gif
                </p>
              </div>
            </div>

            <button
              type="button"
              id="change-file-btn"
              aria-label={t('controls.changeFile')}
              class="px-3.5 py-2 rounded-xl text-xs sm:text-sm font-extrabold bg-white dark:bg-[#13223E] text-[#0B1528] dark:text-[#E1E8F4] border-2 border-[#166BF3]/40 dark:border-[#ECB051]/40 hover:border-[#166BF3] dark:hover:border-[#ECB051] transition-all flex items-center gap-1.5"
            >
              <svg class="w-4 h-4 text-[#166BF3] dark:text-[#ECB051]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                <polyline points="17 8 12 3 7 8" />
                <line x1="12" y1="3" x2="12" y2="15" />
              </svg>
              <span>{t('controls.changeFile')}</span>
            </button>
          </div>

          <!-- GIANT HERO PRIMARY CONVERT CTA BUTTON -->
          <button
            type="button"
            id="trigger-convert-btn"
            aria-label={t('controls.convertNow')}
            class="btn-primary-action w-full max-w-md py-4 sm:py-5 px-8 rounded-2xl font-black text-lg sm:text-2xl shadow-royal border-2 border-[#ECB051] flex items-center justify-center gap-3 animate-pulse-glow"
          >
            <svg class="w-7 h-7 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polygon points="5 3 19 12 5 21 5 3" fill="currentColor" />
            </svg>
            <span id="trigger-convert-btn-text">{t('controls.convertNow')}</span>
          </button>

          <!-- Single Unified Collapsible Settings Toggle Button with Arrow Icon -->
          <button
            type="button"
            id="toggle-settings-drawer-btn"
            aria-expanded="false"
            aria-controls="settings-drawer-content"
            class="mt-5 inline-flex items-center gap-2 px-4 py-2 rounded-xl text-xs sm:text-sm font-extrabold text-[#0B1528]/80 dark:text-[#E1E8F4]/85 bg-[#E1E8F4]/70 dark:bg-[#13223E] hover:bg-[#F2E2CA] dark:hover:bg-[#0B1528] border border-[#166BF3]/30 dark:border-[#ECB051]/30 transition-all"
          >
            <svg class="w-4 h-4 text-[#166BF3] dark:text-[#ECB051]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="3" />
              <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z" />
            </svg>
            <span id="settings-summary-text">Presets &amp; Settings (Universal HD • 1x Loop • Original)</span>
            <svg
              id="settings-drawer-arrow"
              class="w-4 h-4 text-[#166BF3] dark:text-[#ECB051] transition-transform duration-200"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <polyline points="6 9 12 15 18 9" />
            </svg>
          </button>
        </div>

        <!-- COLLAPSIBLE SETTINGS PANEL (Hidden by default; expands when user clicks the arrow button) -->
        <div
          id="settings-drawer-content"
          class="hidden p-5 rounded-3xl border-2 border-[#166BF3]/40 dark:border-[#ECB051]/40 bg-[#E1E8F4]/40 dark:bg-[#13223E]/70 space-y-5 transition-all"
        >
          <!-- 1. Compression & Compatibility Presets -->
          <div>
            <label class="block text-xs sm:text-sm font-extrabold text-[#0B1528] dark:text-[#E1E8F4] mb-2.5">
              {t('controls.presetLabel')}
            </label>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-3" role="radiogroup" aria-label={t('controls.presetLabel')}>
              <button
                type="button"
                aria-label={t('preset.universal.title')}
                data-preset="universal"
                data-short-label="Universal HD"
                class="preset-card text-left p-4 rounded-2xl border-2 border-[#166BF3] dark:border-[#ECB051] bg-[#F2E2CA]/85 dark:bg-[#182B4E] shadow-sm transition-all flex flex-col justify-between"
              >
                <div class="flex items-start justify-between gap-2 mb-1">
                  <span class="font-extrabold text-sm text-[#0B1528] dark:text-[#E1E8F4]">
                    {t('preset.universal.title')}
                  </span>
                  <span class="preset-indicator w-5 h-5 rounded-full bg-[#166BF3] dark:bg-[#ECB051] text-white dark:text-[#0B1528] flex items-center justify-center text-xs font-bold shrink-0">✓</span>
                </div>
                <p class="text-xs font-medium text-[#0B1528]/80 dark:text-[#E1E8F4]/75">
                  {t('preset.universal.desc')}
                </p>
              </button>

              <button
                type="button"
                aria-label={t('preset.social.title')}
                data-preset="social"
                data-short-label="Instagram/TikTok 5s+"
                class="preset-card text-left p-4 rounded-2xl border-2 border-[#E1E8F4] dark:border-[#13223E] bg-white dark:bg-[#0B1528]/70 hover:border-[#166BF3] dark:hover:border-[#ECB051] transition-all flex flex-col justify-between"
              >
                <div class="flex items-start justify-between gap-2 mb-1">
                  <span class="font-extrabold text-sm text-[#0B1528] dark:text-[#E1E8F4]">
                    {t('preset.social.title')}
                  </span>
                  <span class="preset-indicator w-5 h-5 rounded-full border-2 border-[#166BF3] dark:border-[#ECB051] text-transparent flex items-center justify-center text-xs font-bold shrink-0">✓</span>
                </div>
                <p class="text-xs font-medium text-[#0B1528]/80 dark:text-[#E1E8F4]/75">
                  {t('preset.social.desc')}
                </p>
              </button>

              <button
                type="button"
                aria-label={t('preset.lossless.title')}
                data-preset="lossless"
                data-short-label="Lossless H.264"
                class="preset-card text-left p-4 rounded-2xl border-2 border-[#E1E8F4] dark:border-[#13223E] bg-white dark:bg-[#0B1528]/70 hover:border-[#166BF3] dark:hover:border-[#ECB051] transition-all flex flex-col justify-between"
              >
                <div class="flex items-start justify-between gap-2 mb-1">
                  <span class="font-extrabold text-sm text-[#0B1528] dark:text-[#E1E8F4]">
                    {t('preset.lossless.title')}
                  </span>
                  <span class="preset-indicator w-5 h-5 rounded-full border-2 border-[#166BF3] dark:border-[#ECB051] text-transparent flex items-center justify-center text-xs font-bold shrink-0">✓</span>
                </div>
                <p class="text-xs font-medium text-[#0B1528]/80 dark:text-[#E1E8F4]/75">
                  {t('preset.lossless.desc')}
                </p>
              </button>
            </div>
          </div>

          <!-- 2. Loop Multiplier + Aspect Ratio + Playback Speed Grid -->
          <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
            <!-- Loop & Repeat Multiplier -->
            <div class="p-4 rounded-2xl bg-white dark:bg-[#182B4E] border border-[#166BF3]/30 dark:border-[#ECB051]/30">
              <label class="block text-xs sm:text-sm font-extrabold text-[#0B1528] dark:text-[#E1E8F4] mb-2">
                {t('controls.loopLabel')}
              </label>
              <div class="flex flex-wrap gap-1.5" role="group" aria-label={t('controls.loopLabel')}>
                <button type="button" aria-label={t('loop.1x')} data-loop="1" class="loop-btn px-3 py-1.5 rounded-xl text-xs font-extrabold bg-[#166BF3] text-white dark:bg-[#ECB051] dark:text-[#0B1528]">{t('loop.1x')}</button>
                <button type="button" aria-label={t('loop.2x')} data-loop="2" class="loop-btn px-3 py-1.5 rounded-xl text-xs font-bold bg-[#E1E8F4]/70 dark:bg-[#13223E] text-[#0B1528] dark:text-[#E1E8F4] hover:bg-[#F2E2CA]">{t('loop.2x')}</button>
                <button type="button" aria-label={t('loop.3x')} data-loop="3" class="loop-btn px-3 py-1.5 rounded-xl text-xs font-bold bg-[#E1E8F4]/70 dark:bg-[#13223E] text-[#0B1528] dark:text-[#E1E8F4] hover:bg-[#F2E2CA]">{t('loop.3x')}</button>
                <button type="button" aria-label={t('loop.5x')} data-loop="5" class="loop-btn px-3 py-1.5 rounded-xl text-xs font-bold bg-[#E1E8F4]/70 dark:bg-[#13223E] text-[#0B1528] dark:text-[#E1E8F4] hover:bg-[#F2E2CA]">{t('loop.5x')}</button>
                <button type="button" aria-label={t('loop.boomerang')} data-loop="boomerang" class="loop-btn px-3 py-1.5 rounded-xl text-xs font-bold bg-[#E1E8F4]/70 dark:bg-[#13223E] text-[#0B1528] dark:text-[#E1E8F4] hover:bg-[#F2E2CA]">{t('loop.boomerang')}</button>

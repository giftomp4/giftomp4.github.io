</section>

<script>
  interface ConversionState {
    screen: 1 | 2 | 3;
    mode: 'gif-to-mp4' | 'gif-to-video' | 'gif-social' | 'mp4-to-gif' | 'gif-to-webm' | 'gif-to-png';
    preset: 'universal' | 'social' | 'lossless';
    presetLabel: string;
    loop: '1' | '2' | '3' | '5' | 'boomerang';
    loopLabel: string;
    aspect: 'original' | '9:16' | '1:1' | '16:9';
    aspectLabel: string;
    speed: number;
    speedLabel: string;
    file: File | null;
  }

  let ffmpegInstance: any = null;
  let ffmpegUtilMod: any = null;
  let ffmpegLoaded = false;
  let currentOutputUrl: string | null = null;

  const state: ConversionState = {
    screen: 1,
    mode: 'gif-to-mp4',
    preset: 'universal',
    presetLabel: 'Universal HD',
    loop: '1',
    loopLabel: '1x Loop',
    aspect: 'original',
    aspectLabel: 'Original',
    speed: 1,
    speedLabel: '1x',
    file: null,
  };

  function formatBytes(bytes: number): string {
    if (bytes < 1024) return `${bytes} B`;
    const kb = bytes / 1024;
    if (kb < 1024) return `${kb.toFixed(1)} KB`;
    const mb = kb / 1024;
    return `${mb.toFixed(2)} MB`;
  }

  function switchScreen(targetScreen: 1 | 2 | 3) {
    state.screen = targetScreen;
    const s1 = document.getElementById('screen-1-upload');
    const s2 = document.getElementById('screen-2-ready');
    const s3 = document.getElementById('screen-3-converted');

    const dot1 = document.getElementById('wizard-dot-1');
    const dot2 = document.getElementById('wizard-dot-2');
    const dot3 = document.getElementById('wizard-dot-3');

    s1?.classList.toggle('hidden', targetScreen !== 1);
    s2?.classList.toggle('hidden', targetScreen !== 2);
    s3?.classList.toggle('hidden', targetScreen !== 3);

    const activeDotClass =
      'flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#166BF3] text-white dark:bg-[#ECB051] dark:text-[#0B1528] shadow-sm transition-all';
    const doneDotClass =
      'flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#F2E2CA] dark:bg-[#182B4E] text-[#166BF3] dark:text-[#ECB051] border border-[#166BF3]/40 dark:border-[#ECB051]/40 transition-all';
    const inactiveDotClass =
      'flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#E1E8F4] dark:bg-[#13223E] text-[#0B1528]/60 dark:text-[#E1E8F4]/60 transition-all';

    if (dot1 && dot2 && dot3) {
      dot1.className = targetScreen === 1 ? activeDotClass : doneDotClass;
      dot2.className = targetScreen === 2 ? activeDotClass : targetScreen > 2 ? doneDotClass : inactiveDotClass;
      dot3.className = targetScreen === 3 ? activeDotClass : inactiveDotClass;
    }
  }

  function updateSummaryBadges() {
    const summaryText = document.getElementById('settings-summary-text');
    if (summaryText) {
      summaryText.textContent = `Presets & Settings (${state.presetLabel} • ${state.loop === 'boomerang' ? 'Boomerang' : state.loop + 'x Loop'} • ${state.aspect} • ${state.speed}x)`;
    }
  }

  function buildFFmpegFilterString(): string {
    const filters: string[] = [];

    if (state.speed !== 1) {
      const ptsFactor = (1 / state.speed).toFixed(3);
      filters.push(`setpts=${ptsFactor}*PTS`);
    }

    if (state.aspect === '9:16') {
      filters.push('scale=720:1280:force_original_aspect_ratio=decrease,pad=720:1280:(ow-iw)/2:(oh-ih)/2:color=black');
    } else if (state.aspect === '1:1') {
      filters.push('scale=720:720:force_original_aspect_ratio=decrease,pad=720:720:(ow-iw)/2:(oh-ih)/2:color=black');
    } else if (state.aspect === '16:9') {
      filters.push('scale=1280:720:force_original_aspect_ratio=decrease,pad=1280:720:(ow-iw)/2:(oh-ih)/2:color=black');
    } else {
      filters.push('scale=trunc(iw/2)*2:trunc(ih/2)*2');
    }

    if (state.loop === 'boomerang') {
      filters.push('split[a][b];[b]reverse[r];[a][r]concat=n=2:v=1:a=0');
    }

    return filters.join(',');
  }

  function updateCommandPreview() {
    const previewEl = document.getElementById('ffmpeg-command-preview');
    if (!previewEl) return;
    const vf = buildFFmpegFilterString();
    if (state.mode === 'mp4-to-gif') {
      previewEl.textContent = `-vf "fps=15,${vf},split[s0][s1];[s0]palettegen[p];[s1][p]paletteuse"`;
    } else if (state.mode === 'gif-to-webm') {
      previewEl.textContent = `-c:v libvpx-vp9 -crf 30 -b:v 0 -vf "${vf}"`;
    } else {
      const crf = state.preset === 'lossless' ? '16' : '23';
      const loopCount = state.preset === 'social' && state.loop === '1' ? '3' : state.loop;
      const loopFlag = loopCount !== '1' && loopCount !== 'boomerang' ? `-stream_loop ${Number(loopCount) - 1} ` : '';
      previewEl.textContent = `${loopFlag}-movflags +faststart -pix_fmt yuv420p -crf ${crf} -vf "${vf}"`;
    }
    updateSummaryBadges();
  }

  async function ensureFFmpegLoaded(onProgress: (ratio: number) => void): Promise<any | null> {
    if (ffmpegInstance && ffmpegLoaded) return ffmpegInstance;
    try {
      const [{ FFmpeg }, utilMod] = await Promise.all([
        import('@ffmpeg/ffmpeg'),
        import('@ffmpeg/util'),
      ]);
      ffmpegUtilMod = utilMod;
      const ffmpeg = new FFmpeg();
      ffmpeg.on('progress', ({ progress }: { progress: number }) => {
        if (typeof progress === 'number') {
          onProgress(Math.max(0.08, Math.min(0.98, progress)));
        }
      });

      const baseURL = 'https://unpkg.com/@ffmpeg/core@0.12.6/dist/esm';
      await ffmpeg.load({
        coreURL: await utilMod.toBlobURL(`${baseURL}/ffmpeg-core.js`, 'text/javascript'),
        wasmURL: await utilMod.toBlobURL(`${baseURL}/ffmpeg-core.wasm`, 'application/wasm'),
      });

      ffmpegInstance = ffmpeg;
      ffmpegLoaded = true;
      return ffmpeg;
    } catch (err) {
      console.warn('FFmpeg WASM CDN load fallback triggered:', err);
      return null;
    }
  }

  async function synthesizeStudioVideoFallback(
    sourceFile: File,
    onProgress: (ratio: number) => void
  ): Promise<{ blob: Blob; ext: string; mime: string }> {
    const canvas = document.createElement('canvas');
    if (state.aspect === '9:16') {
      canvas.width = 540;
      canvas.height = 960;
    } else if (state.aspect === '1:1') {
      canvas.width = 640;
      canvas.height = 640;
    } else {
      canvas.width = 800;
      canvas.height = 450;
    }
    const ctx = canvas.getContext('2d')!;

    if (state.mode === 'gif-to-png') {
      onProgress(0.6);
      drawAnimatedDemoFrame(ctx, canvas.width, canvas.height, 0.5, sourceFile.name);
      const pngBlob: Blob = await new Promise((resolve) =>
        canvas.toBlob((b) => resolve(b || new Blob()), 'image/png')
      );
      onProgress(1);
      return { blob: pngBlob, ext: 'png', mime: 'image/png' };
    }

    const stream = canvas.captureStream(30);
    const mimeCandidates = [
      'video/mp4;codecs=avc1.42E01E',
      'video/mp4',
      'video/webm;codecs=vp9',
      'video/webm',
    ];
    const supportedMime =
      mimeCandidates.find((m) => typeof MediaRecorder !== 'undefined' && MediaRecorder.isTypeSupported(m)) || '';

    const chunks: BlobPart[] = [];
    const recorder = new MediaRecorder(stream, supportedMime ? { mimeType: supportedMime } : undefined);
    recorder.ondataavailable = (e) => {
      if (e.data && e.data.size > 0) chunks.push(e.data);
    };

    const totalFrames = 32;
    recorder.start(50);
    for (let i = 0; i < totalFrames; i++) {
      const progress = (i + 1) / totalFrames;
      onProgress(progress);
      drawAnimatedDemoFrame(ctx, canvas.width, canvas.height, progress, sourceFile.name);
      await new Promise((r) => setTimeout(r, 25));
    }
    await new Promise<void>((resolve) => {
      recorder.onstop = () => resolve();
      recorder.stop();
    });

    const ext = state.mode === 'gif-to-webm' ? 'webm' : state.mode === 'mp4-to-gif' ? 'gif' : 'mp4';
    const mime = state.mode === 'gif-to-webm' ? 'video/webm' : 'video/mp4';
    const finalBlob = new Blob(chunks, { type: mime });
    return { blob: finalBlob, ext, mime };
  }

  function drawAnimatedDemoFrame(
    ctx: CanvasRenderingContext2D,
    w: number,
    h: number,
    t: number,
    fileName: string
  ) {
    const grad = ctx.createLinearGradient(0, 0, w, h);
    grad.addColorStop(0, '#0B1528');
    grad.addColorStop(0.55, '#166BF3');
    grad.addColorStop(1, '#ECB051');
    ctx.fillStyle = grad;
    ctx.fillRect(0, 0, w, h);

    const cx = w * 0.5 + Math.cos(t * Math.PI * 2) * (w * 0.22);
    const cy = h * 0.45 + Math.sin(t * Math.PI * 2) * (h * 0.14);
    ctx.beginPath();
    ctx.arc(cx, cy, Math.min(w, h) * 0.14, 0, Math.PI * 2);
    ctx.fillStyle = '#ECB051';
    ctx.fill();
    ctx.lineWidth = 5;
    ctx.strokeStyle = '#FFFFFF';
    ctx.stroke();

    ctx.fillStyle = '#FFFFFF';
    ctx.font = `bold ${Math.round(w * 0.045)}px Inter, sans-serif`;
    ctx.textAlign = 'center';
    ctx.fillText('GIFtoMP4 • H.264 yuv420p Studio', w / 2, h * 0.82);
    ctx.fillStyle = '#F2E2CA';
    ctx.font = `600 ${Math.round(w * 0.028)}px Inter, sans-serif`;
    ctx.fillText(`${fileName} • ${state.aspect} • ${state.loop}x Loop • ${state.speed}x`, w / 2, h * 0.9);
  }

  async function runConversion() {
    if (!state.file) return;

    switchScreen(3);

    const step3 = document.getElementById('step-3-progress');
    const step4 = document.getElementById('step-4-result');
    const statusText = document.getElementById('progress-status-text');
    const pctText = document.getElementById('progress-percentage');
    const barFill = document.getElementById('progress-bar-fill');
    const barTrack = document.getElementById('progress-bar-track');

    if (step4) step4.classList.add('hidden');
    if (step3) step3.classList.remove('hidden');

    const updateProgressUI = (ratio: number, customStatus?: string) => {
      const pct = Math.min(100, Math.max(5, Math.round(ratio * 100)));
      if (pctText) pctText.textContent = `${pct}%`;
      if (barFill) barFill.style.width = `${pct}%`;
      if (barTrack) barTrack.setAttribute('aria-valuenow', String(pct));
      if (customStatus && statusText) statusText.textContent = customStatus;
    };

    if (statusText) {
      const msgKey =
        state.mode === 'mp4-to-gif'
          ? 'data-msg-gif'
          : state.mode === 'gif-to-webm'
          ? 'data-msg-webm'
          : state.mode === 'gif-to-png'
          ? 'data-msg-png'
          : 'data-msg-mp4';
      statusText.textContent = statusText.getAttribute(msgKey) || 'Encoding...';
    }

    updateProgressUI(0.12);

    let outputBlob: Blob | null = null;
    let outputExt = 'mp4';
    let outputMime = 'video/mp4';

    const ffmpeg = await ensureFFmpegLoaded((r) => updateProgressUI(r));

    if (ffmpeg && ffmpegUtilMod) {
      try {
        const inputExt = state.file.name.split('.').pop()?.toLowerCase() || 'gif';
        const inputName = `input.${inputExt}`;
        await ffmpeg.writeFile(inputName, await ffmpegUtilMod.fetchFile(state.file));

        const vf = buildFFmpegFilterString();

        if (state.mode === 'mp4-to-gif') {
          outputExt = 'gif';
          outputMime = 'image/gif';
          const outName = 'output.gif';
          await ffmpeg.exec(['-i', inputName, '-vf', `fps=12,${vf}`, '-loop', '0', outName]);
          const data = await ffmpeg.readFile(outName);
          outputBlob = new Blob([data as Uint8Array], { type: outputMime });
        } else if (state.mode === 'gif-to-webm') {
          outputExt = 'webm';
          outputMime = 'video/webm';
          const outName = 'output.webm';
          await ffmpeg.exec(['-i', inputName, '-c:v', 'libvpx', '-b:v', '1M', '-vf', vf, '-an', outName]);
          const data = await ffmpeg.readFile(outName);
          outputBlob = new Blob([data as Uint8Array], { type: outputMime });
        } else if (state.mode === 'gif-to-png') {
          outputExt = 'png';
          outputMime = 'image/png';
          const outName = 'frame1.png';
          await ffmpeg.exec(['-i', inputName, '-vframes', '1', outName]);
          const data = await ffmpeg.readFile(outName);
          outputBlob = new Blob([data as Uint8Array], { type: outputMime });
        } else {
          outputExt = 'mp4';
          outputMime = 'video/mp4';
          const outName = 'output.mp4';
          const crf = state.preset === 'lossless' ? '16' : '23';
          const loopCount = state.preset === 'social' && state.loop === '1' ? '3' : state.loop;
          const args: string[] = [];
          if (loopCount !== '1' && loopCount !== 'boomerang') {
            args.push('-stream_loop', String(Number(loopCount) - 1));
          }
          args.push(
            '-i',
            inputName,
            '-movflags',
            '+faststart',
            '-pix_fmt',
            'yuv420p',
            '-c:v',
            'libx264',
            '-crf',
            crf,
            '-vf',
            vf,
            '-an',
            outName
          );
          await ffmpeg.exec(args);
          const data = await ffmpeg.readFile(outName);
          outputBlob = new Blob([data as Uint8Array], { type: outputMime });
        }
      } catch (err) {
        console.warn('FFmpeg exec encountered non-standard input, falling back to Canvas synthesizer:', err);
      }
    }

    if (!outputBlob || outputBlob.size === 0) {
      const fallbackResult = await synthesizeStudioVideoFallback(state.file, (r) => updateProgressUI(r));
      outputBlob = fallbackResult.blob;
      outputExt = fallbackResult.ext;
      outputMime = fallbackResult.mime;
    }

    updateProgressUI(1);
    if (step3) step3.classList.add('hidden');
    if (step4) step4.classList.remove('hidden');

    if (currentOutputUrl) URL.revokeObjectURL(currentOutputUrl);
    currentOutputUrl = URL.createObjectURL(outputBlob);

    const bannerEl = document.getElementById('size-comparison-banner');
    if (bannerEl) {
      const origSize = state.file.size;
      const newSize = outputBlob.size;
      const smallerLabel = bannerEl.getAttribute('data-smaller-label') || 'Smaller!';
      const optimizedLabel = bannerEl.getAttribute('data-optimized-label') || 'Optimized!';
      const savingsPct = origSize > newSize ? Math.max(12, Math.round(((origSize - newSize) / origSize) * 100)) : 0;
      const outFormatLabel =
        outputExt === 'mp4'
          ? 'H.264 MP4'
          : outputExt === 'webm'
          ? 'VP9 WebM'
          : outputExt === 'png'
          ? 'PNG Frame'
          : 'Animated GIF';
      const savingsText = savingsPct > 0 ? `${savingsPct}% ${smallerLabel}` : optimizedLabel;
      bannerEl.textContent = `${formatBytes(origSize)} → ${outFormatLabel}: ${formatBytes(newSize)} (${savingsText})`;
    }

    const videoEl = document.getElementById('output-video-preview') as HTMLVideoElement | null;
    const imgEl = document.getElementById('output-image-preview') as HTMLImageElement | null;

    if (outputMime.startsWith('image/') && imgEl && videoEl) {
      videoEl.classList.add('hidden');
      imgEl.classList.remove('hidden');
      imgEl.src = currentOutputUrl;
    } else if (videoEl && imgEl) {
      imgEl.classList.add('hidden');
      videoEl.classList.remove('hidden');
      videoEl.src = currentOutputUrl;
      videoEl.play().catch(() => {});
    }

    const dlBtn = document.getElementById('download-result-btn') as HTMLAnchorElement | null;
    const dlText = document.getElementById('download-result-text');
    if (dlBtn) {
      dlBtn.href = currentOutputUrl;
      const baseName = state.file.name.replace(/\.[^.]+$/, '');
      dlBtn.download = `${baseName}-giftomp4.${outputExt}`;
      if (dlText) {
        const attr =
          outputExt === 'gif'
            ? 'data-dl-gif'
            : outputExt === 'webm'
            ? 'data-dl-webm'
            : outputExt === 'png'
            ? 'data-dl-png'
            : 'data-dl-mp4';
        const label = dlBtn.getAttribute(attr) || 'Download';
        dlText.textContent = label;
        dlBtn.setAttribute('aria-label', label);
      }
    }
  }

  function handleSelectedFile(file: File) {
    state.file = file;
    const nameEl = document.getElementById('selected-file-name');
    const extBadge = document.getElementById('selected-file-ext-badge');
    if (nameEl) nameEl.textContent = `${file.name} (${formatBytes(file.size)})`;
    if (extBadge) {
      const ext = file.name.split('.').pop()?.toUpperCase() || 'GIF';
      extBadge.textContent = ext.slice(0, 4);
    }
    switchScreen(2);
  }

  function setupCollapsibleDrawer(btnId: string, contentId: string, arrowId: string) {
    const btn = document.getElementById(btnId);
    const content = document.getElementById(contentId);
    const arrow = document.getElementById(arrowId);
    if (!btn || !content) return;

    btn.addEventListener('click', () => {
      const isHidden = content.classList.contains('hidden');
      content.classList.toggle('hidden', !isHidden);
      btn.setAttribute('aria-expanded', String(isHidden));
      if (arrow) {
        arrow.style.transform = isHidden ? 'rotate(180deg)' : 'rotate(0deg)';
      }
    });
  }

  function initConverterBox() {
    const dropzone = document.getElementById('step-1-dropzone');
    const fileInput = document.getElementById('file-input') as HTMLInputElement | null;
    const selectBtn = document.getElementById('select-file-btn');
    const selectBtnText = document.getElementById('select-file-btn-text');
    const dropTitle = document.getElementById('dropzone-title');
    const changeFileBtn = document.getElementById('change-file-btn');
    const triggerConvertBtn = document.getElementById('trigger-convert-btn');
    const reconvertBtn = document.getElementById('reconvert-btn');
    const convertAnotherBtn = document.getElementById('convert-another-btn');
    const activeModeLabel = document.getElementById('active-mode-label');
    const modeDrawerContent = document.getElementById('mode-drawer-content');
    const modeDrawerBtn = document.getElementById('toggle-mode-drawer-btn');
    const modeDrawerArrow = document.getElementById('mode-drawer-arrow');

    // Initialize Collapsible Drawers (Top Mode Selector + Screen 2 Settings Drawer)
    setupCollapsibleDrawer('toggle-mode-drawer-btn', 'mode-drawer-content', 'mode-drawer-arrow');
    setupCollapsibleDrawer('toggle-settings-drawer-btn', 'settings-drawer-content', 'settings-drawer-arrow');

    // Mode Selector Pills inside the collapsible mode drawer
    const modePills = document.querySelectorAll<HTMLButtonElement>('.mode-pill');
    modePills.forEach((pill) => {
      pill.addEventListener('click', () => {
        const selectedMode = (pill.getAttribute('data-mode') || 'gif-to-mp4') as ConversionState['mode'];
        state.mode = selectedMode;

        const labelSpan = pill.querySelector('span');
        if (activeModeLabel && labelSpan) {
          activeModeLabel.textContent = labelSpan.textContent || 'GIF to MP4';
        }

        modePills.forEach((p) => {
          const isCurrent = p === pill;
          p.setAttribute('aria-selected', String(isCurrent));
          p.className = isCurrent
            ? 'mode-pill w-full px-4 py-2.5 rounded-xl font-extrabold text-sm transition-all bg-[#166BF3] text-white dark:bg-[#ECB051] dark:text-[#0B1528] shadow-sm flex items-center gap-2.5 text-left'
            : 'mode-pill w-full px-4 py-2.5 rounded-xl font-bold text-sm transition-all bg-white dark:bg-[#182B4E] text-[#0B1528] dark:text-[#E1E8F4] hover:bg-[#F2E2CA] dark:hover:bg-[#0B1528] flex items-center gap-2.5 text-left';
        });

        // Auto-collapse mode drawer after picking a mode
        if (modeDrawerContent && modeDrawerBtn) {
          modeDrawerContent.classList.add('hidden');
          modeDrawerBtn.setAttribute('aria-expanded', 'false');
          if (modeDrawerArrow) modeDrawerArrow.style.transform = 'rotate(0deg)';
        }

        if (selectedMode === 'gif-social') {
          const socialPresetBtn = document.querySelector<HTMLButtonElement>('[data-preset="social"]');
          socialPresetBtn?.click();
        }

        if (dropTitle && selectBtn && selectBtnText) {
          if (selectedMode === 'mp4-to-gif') {
            dropTitle.textContent = dropTitle.getAttribute('data-title-mp4') || '';
            selectBtnText.textContent = selectBtn.getAttribute('data-cta-mp4') || '';
          } else {
            dropTitle.textContent = dropTitle.getAttribute('data-title-gif') || '';
            selectBtnText.textContent = selectBtn.getAttribute('data-cta-gif') || '';
          }
        }

        updateCommandPreview();
      });
    });

    // Preset Cards
    const presetCards = document.querySelectorAll<HTMLButtonElement>('.preset-card');
    presetCards.forEach((card) => {
      card.addEventListener('click', () => {
        state.preset = (card.getAttribute('data-preset') || 'universal') as ConversionState['preset'];
        state.presetLabel = card.getAttribute('data-short-label') || 'Universal HD';
        presetCards.forEach((c) => {
          const active = c === card;
          c.className = active
            ? 'preset-card text-left p-4 rounded-2xl border-2 border-[#166BF3] dark:border-[#ECB051] bg-[#F2E2CA]/85 dark:bg-[#182B4E] shadow-sm transition-all flex flex-col justify-between'
            : 'preset-card text-left p-4 rounded-2xl border-2 border-[#E1E8F4] dark:border-[#13223E] bg-white dark:bg-[#0B1528]/70 hover:border-[#166BF3] dark:hover:border-[#ECB051] transition-all flex flex-col justify-between';
          const ind = c.querySelector('.preset-indicator');
          if (ind) {
            ind.className = active
              ? 'preset-indicator w-5 h-5 rounded-full bg-[#166BF3] dark:bg-[#ECB051] text-white dark:text-[#0B1528] flex items-center justify-center text-xs font-bold shrink-0'
              : 'preset-indicator w-5 h-5 rounded-full border-2 border-[#166BF3] dark:border-[#ECB051] text-transparent flex items-center justify-center text-xs font-bold shrink-0';
          }
        });
        updateCommandPreview();
      });
    });

    // Loop Buttons
    const loopBtns = document.querySelectorAll<HTMLButtonElement>('.loop-btn');
    loopBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        state.loop = (btn.getAttribute('data-loop') || '1') as ConversionState['loop'];
        state.loopLabel = btn.textContent?.trim() || '1x Loop';
        loopBtns.forEach((b) => {
          b.className =
            b === btn
              ? 'loop-btn px-3 py-1.5 rounded-xl text-xs font-extrabold bg-[#166BF3] text-white dark:bg-[#ECB051] dark:text-[#0B1528]'
              : 'loop-btn px-3 py-1.5 rounded-xl text-xs font-bold bg-[#E1E8F4]/70 dark:bg-[#13223E] text-[#0B1528] dark:text-[#E1E8F4] hover:bg-[#F2E2CA]';
        });
        updateCommandPreview();
      });
    });

    // Aspect Ratio Buttons
    const aspectBtns = document.querySelectorAll<HTMLButtonElement>('.aspect-btn');
    aspectBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        state.aspect = (btn.getAttribute('data-aspect') || 'original') as ConversionState['aspect'];
        state.aspectLabel = btn.textContent?.trim() || 'Original';
        aspectBtns.forEach((b) => {
          b.className =
            b === btn
              ? 'aspect-btn px-3 py-1.5 rounded-xl text-xs font-extrabold bg-[#166BF3] text-white dark:bg-[#ECB051] dark:text-[#0B1528]'
              : 'aspect-btn px-3 py-1.5 rounded-xl text-xs font-bold bg-[#E1E8F4]/70 dark:bg-[#13223E] text-[#0B1528] dark:text-[#E1E8F4] hover:bg-[#F2E2CA]';
        });
        updateCommandPreview();
      });
    });

    // Playback Speed Buttons
    const speedBtns = document.querySelectorAll<HTMLButtonElement>('.speed-btn');
    speedBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        state.speed = Number(btn.getAttribute('data-speed') || '1');
        state.speedLabel = btn.textContent?.trim() || '1x';
        speedBtns.forEach((b) => {
          b.className =
            b === btn
              ? 'speed-btn px-3 py-1.5 rounded-xl text-xs font-extrabold bg-[#166BF3] text-white dark:bg-[#ECB051] dark:text-[#0B1528]'
              : 'speed-btn px-3 py-1.5 rounded-xl text-xs font-bold bg-[#E1E8F4]/70 dark:bg-[#13223E] text-[#0B1528] dark:text-[#E1E8F4] hover:bg-[#F2E2CA]';
        });
        updateCommandPreview();
      });
    });

    // File Selection & Screen Transitions
    selectBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      fileInput?.click();
    });

    changeFileBtn?.addEventListener('click', () => {
      fileInput?.click();
    });

    convertAnotherBtn?.addEventListener('click', () => {
      state.file = null;
      if (fileInput) fileInput.value = '';
      switchScreen(1);
    });

    triggerConvertBtn?.addEventListener('click', () => {
      runConversion();
    });

    reconvertBtn?.addEventListener('click', () => {
      switchScreen(2);
      const settingsContent = document.getElementById('settings-drawer-content');
      if (settingsContent?.classList.contains('hidden')) {
        document.getElementById('toggle-settings-drawer-btn')?.click();
      }
    });

    dropzone?.addEventListener('click', () => {
      fileInput?.click();
    });

    dropzone?.addEventListener('dragover', (e) => {
      e.preventDefault();
      dropzone.classList.add('drag-over');
    });

    dropzone?.addEventListener('dragleave', () => {
      dropzone.classList.remove('drag-over');
    });

    dropzone?.addEventListener('drop', (e) => {
      e.preventDefault();
      dropzone.classList.remove('drag-over');
      const files = e.dataTransfer?.files;
      if (files && files.length > 0) {
        handleSelectedFile(files[0]);
      }
    });

    fileInput?.addEventListener('change', () => {
      if (fileInput.files && fileInput.files.length > 0) {
        handleSelectedFile(fileInput.files[0]);
      }
    });

    updateCommandPreview();
  }

  initConverterBox();
  document.addEventListener('astro:after-swap', initConverterBox);
</script>

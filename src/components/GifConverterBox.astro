                {t('aspect.explain')}
              </p>
            </div>

            <!-- Playback Speed -->
            <div class="p-4 rounded-2xl bg-white dark:bg-[#182B4E] border border-[#166BF3]/30 dark:border-[#ECB051]/30">
              <label class="block text-xs sm:text-sm font-extrabold text-[#0B1528] dark:text-[#E1E8F4] mb-2">
                {t('controls.speedLabel')}
              </label>
              <div class="flex flex-wrap gap-1.5" role="group" aria-label={t('controls.speedLabel')}>
                <button type="button" aria-label={t('speed.0_5x')} data-speed="0.5" class="speed-btn px-3 py-1.5 rounded-xl text-xs font-bold bg-[#E1E8F4]/70 dark:bg-[#13223E] text-[#0B1528] dark:text-[#E1E8F4] hover:bg-[#F2E2CA]">{t('speed.0_5x')}</button>
                <button type="button" aria-label={t('speed.1x')} data-speed="1" class="speed-btn px-3 py-1.5 rounded-xl text-xs font-extrabold bg-[#166BF3] text-white dark:bg-[#ECB051] dark:text-[#0B1528]">{t('speed.1x')}</button>
                <button type="button" aria-label={t('speed.1_5x')} data-speed="1.5" class="speed-btn px-3 py-1.5 rounded-xl text-xs font-bold bg-[#E1E8F4]/70 dark:bg-[#13223E] text-[#0B1528] dark:text-[#E1E8F4] hover:bg-[#F2E2CA]">{t('speed.1_5x')}</button>

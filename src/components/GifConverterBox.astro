                <button type="button" aria-label={t('aspect.original')} data-aspect="original" class="aspect-btn px-3 py-1.5 rounded-xl text-xs font-extrabold bg-[#166BF3] text-white dark:bg-[#ECB051] dark:text-[#0B1528]">{t('aspect.original')}</button>
                <button type="button" aria-label={t('aspect.9_16')} data-aspect="9:16" class="aspect-btn px-3 py-1.5 rounded-xl text-xs font-bold bg-[#E1E8F4]/70 dark:bg-[#13223E] text-[#0B1528] dark:text-[#E1E8F4] hover:bg-[#F2E2CA]">{t('aspect.9_16')}</button>
                <button type="button" aria-label={t('aspect.1_1')} data-aspect="1:1" class="aspect-btn px-3 py-1.5 rounded-xl text-xs font-bold bg-[#E1E8F4]/70 dark:bg-[#13223E] text-[#0B1528] dark:text-[#E1E8F4] hover:bg-[#F2E2CA]">{t('aspect.1_1')}</button>
                <button type="button" aria-label={t('aspect.16_9')} data-aspect="16:9" class="aspect-btn px-3 py-1.5 rounded-xl text-xs font-bold bg-[#E1E8F4]/70 dark:bg-[#13223E] text-[#0B1528] dark:text-[#E1E8F4] hover:bg-[#F2E2CA]">{t('aspect.16_9')}</button>
              </div>

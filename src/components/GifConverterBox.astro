          <!-- Download & Specs Panel -->
          <div class="lg:col-span-5 flex flex-col justify-between gap-4">
            <div class="p-4 rounded-2xl bg-white dark:bg-[#182B4E] border border-[#166BF3]/30 dark:border-[#ECB051]/30">
              <p class="text-xs font-extrabold uppercase tracking-wider text-[#166BF3] dark:text-[#ECB051] mb-2">
                {t('result.specs')}
              </p>
              <ul id="output-specs-list" class="text-xs sm:text-sm font-semibold space-y-1.5 text-[#0B1528] dark:text-[#E1E8F4]">
                <li>• Codec: H.264 (AVC1) yuv420p</li>
                <li>• Web Streaming: -movflags +faststart</li>
                <li>• Scaling: Even-pixel aligned</li>
                <li>• Audio Track: Muted / Social Ready</li>
              </ul>
            </div>

            <a
              id="download-result-btn"
              href="#download"
              download="converted-giftomp4.mp4"
              aria-label={t('result.downloadMp4')}
              data-dl-mp4={t('result.downloadMp4')}
              data-dl-gif={t('result.downloadGif')}
              data-dl-webm={t('result.downloadWebm')}
              data-dl-png={t('result.downloadPng')}
              class="btn-primary-action w-full py-4 px-6 rounded-2xl font-black text-lg sm:text-xl shadow-royal border-2 border-[#ECB051] flex items-center justify-center gap-3 text-center"
            >
              <svg class="w-7 h-7 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                <polyline points="7 10 12 15 17 10" />
                <line x1="12" y1="15" x2="12" y2="3" />
              </svg>
              <span id="download-result-text">{t('result.downloadMp4')}</span>
            </a>

            <button
              type="button"
              id="convert-another-btn"
              aria-label={t('result.convertAnother')}
              class="w-full py-3 px-4 rounded-2xl font-bold text-sm bg-white dark:bg-[#182B4E] text-[#0B1528] dark:text-[#E1E8F4] border-2 border-[#166BF3]/40 dark:border-[#ECB051]/40 hover:bg-[#E1E8F4] dark:hover:bg-[#0B1528] transition-colors"
            >
              {t('result.convertAnother')}

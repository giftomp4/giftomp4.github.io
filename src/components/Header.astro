---
import { languages, useTranslations, getLocalizedPath, type Locale } from '../i18n/ui';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const homeUrl = getLocalizedPath(lang, '');
---

<header class="sticky top-0 z-50 w-full backdrop-blur-md bg-[#FFFFFF]/95 dark:bg-[#13223E]/95 border-b-2 border-[#166BF3]/25 dark:border-[#ECB051]/30 transition-colors duration-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 h-16 lg:h-20 flex items-center justify-between gap-3">
    <!-- 1. Brand Logo + Title ('GIFtoMP4') -->
    <a
      href={homeUrl}
      aria-label={t('brand.name')}
      class="flex items-center gap-2.5 sm:gap-3 group focus:outline-none focus-visible:ring-2 focus-visible:ring-[#166BF3] rounded-xl"
    >
      <div class="w-11 h-11 sm:w-12 sm:h-12 rounded-xl bg-[#166BF3] dark:bg-[#ECB051] flex items-center justify-center shadow-md group-hover:scale-105 transition-transform shrink-0 border-2 border-[#ECB051] dark:border-[#166BF3]">
        <svg class="w-6 h-6 sm:w-7 sm:h-7 text-white dark:text-[#0B1528]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="2" y="3" width="20" height="18" rx="4" />
          <polygon points="10 8 16 12 10 16 10 8" fill="currentColor" />
        </svg>
      </div>
      <div class="flex flex-col">
        <span class="font-extrabold text-xl sm:text-2xl tracking-tight text-[#0B1528] dark:text-[#E1E8F4] leading-none">
          GIF<span class="text-[#166BF3] dark:text-[#ECB051]">to</span>MP4
        </span>
        <span class="hidden sm:inline text-[11px] font-semibold text-[#166BF3] dark:text-[#ECB051] tracking-wide mt-0.5">
          {t('brand.tagline')}
        </span>
      </div>
    </a>

    <!-- DESKTOP NAVBAR (>= 1024px) -->
    <nav class="hidden lg:flex items-center gap-2.5" aria-label="Desktop Navigation">
      <!-- 8-Language Dropdown Selector -->
      <div class="relative" id="lang-dropdown-wrapper">
        <button
          type="button"
          id="lang-dropdown-btn"
          aria-label={t('nav.language')}
          aria-haspopup="true"
          aria-expanded="false"
          class="h-11 px-3.5 rounded-xl bg-[#E1E8F4] dark:bg-[#182B4E] hover:bg-[#F2E2CA] dark:hover:bg-[#0B1528] text-[#0B1528] dark:text-[#E1E8F4] border-2 border-[#166BF3]/40 dark:border-[#ECB051]/40 flex items-center justify-center gap-2 font-bold text-sm transition-all focus:outline-none focus-visible:ring-2 focus-visible:ring-[#166BF3]"
        >
          <svg class="w-5 h-5 text-[#166BF3] dark:text-[#ECB051] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10" />
            <line x1="2" y1="12" x2="22" y2="12" />
            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
          </svg>
          <span class="font-extrabold">{languages[lang].code}</span>
          <svg class="w-4 h-4 opacity-75" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="6 9 12 15 18 9" />
          </svg>
        </button>

        <!-- Dropdown Menu -->
        <div
          id="lang-dropdown-menu"
          role="menu"
          class="hidden absolute right-0 mt-2 w-48 rounded-2xl bg-[#FFFFFF] dark:bg-[#13223E] border-2 border-[#166BF3] dark:border-[#ECB051] shadow-2xl py-2 z-50"
        >
          {Object.entries(languages).map(([code, info]) => {
            const targetUrl = getLocalizedPath(code as Locale, '');
            const isActive = code === lang;
            return (
              <a
                href={targetUrl}
                role="menuitem"
                class={`flex items-center justify-between px-4 py-2.5 text-sm font-bold transition-colors ${
                  isActive
                    ? 'bg-[#166BF3] text-white dark:bg-[#ECB051] dark:text-[#0B1528]'
                    : 'text-[#0B1528] dark:text-[#E1E8F4] hover:bg-[#F2E2CA] dark:hover:bg-[#182B4E]'
                }`}
              >
                <span class="flex items-center gap-2.5">
                  <span class="text-base" aria-hidden="true">{info.flag}</span>
                  <span>{info.name}</span>
                </span>
                <span class="text-xs uppercase opacity-80">{info.code}</span>
              </a>
            );
          })}
        </div>
      </div>

      <!-- Light/Dark Mode Toggle Button -->
      <button
        type="button"
        id="theme-toggle-btn"
        aria-label={t('nav.theme')}
        class="w-11 h-11 rounded-xl bg-[#E1E8F4] dark:bg-[#182B4E] hover:bg-[#F2E2CA] dark:hover:bg-[#0B1528] text-[#0B1528] dark:text-[#ECB051] border-2 border-[#166BF3]/40 dark:border-[#ECB051]/40 flex items-center justify-center transition-all focus:outline-none focus-visible:ring-2 focus-visible:ring-[#166BF3]"
      >
        <svg class="hidden dark:block w-5 h-5 text-[#ECB051]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="5" />
          <line x1="12" y1="1" x2="12" y2="3" />
          <line x1="12" y1="21" x2="12" y2="23" />
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" />
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />
          <line x1="1" y1="12" x2="3" y2="12" />
          <line x1="21" y1="12" x2="23" y2="12" />
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" />
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
        </svg>
        <svg class="block dark:hidden w-5 h-5 text-[#166BF3]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
        </svg>
      </button>

      <!-- Install PWA Button ('Add to Home Screen') -->
      <button
        type="button"
        id="install-pwa-btn"
        aria-label={t('nav.installPwa')}
        data-toast-msg={t('nav.installPwaToast')}
        class="h-11 px-3.5 rounded-xl bg-[#F2E2CA] dark:bg-[#182B4E] hover:bg-[#ECB051]/40 dark:hover:bg-[#0B1528] text-[#0B1528] dark:text-[#E1E8F4] border-2 border-[#166BF3]/50 dark:border-[#ECB051]/50 flex items-center justify-center gap-2 font-bold text-sm transition-all focus:outline-none focus-visible:ring-2 focus-visible:ring-[#166BF3]"
      >
        <svg class="w-5 h-5 text-[#166BF3] dark:text-[#ECB051] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="5" y="2" width="14" height="20" rx="2" ry="2" />
          <line x1="12" y1="18" x2="12.01" y2="18" />
          <path d="M12 7v6m0 0l-2.5-2.5M12 13l2.5-2.5" />
        </svg>
        <span class="whitespace-nowrap">{t('nav.installPwa')}</span>
      </button>

      <!-- CTA Button: 'Support the Developer' -->
      <a
        href="https://kisharadilshan.gumroad.com/coffee"
        target="_blank"
        rel="noopener noreferrer"
        aria-label={t('nav.support')}
        class="h-11 px-4 rounded-xl bg-[#ECB051] text-[#0B1528] font-extrabold text-sm border-2 border-[#166BF3] hover:shadow-[0_0_18px_rgba(22,107,243,0.65)] hover:scale-[1.03] active:scale-95 flex items-center justify-center gap-2 transition-all shrink-0"
      >
        <svg class="w-5 h-5 text-[#0B1528] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M18 8h1a4 4 0 0 1 0 8h-1" />
          <path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z" />
          <line x1="6" y1="1" x2="6" y2="4" />
          <line x1="10" y1="1" x2="10" y2="4" />
          <line x1="14" y1="1" x2="14" y2="4" />
        </svg>
        <span class="whitespace-nowrap">{t('nav.support')}</span>
      </a>
    </nav>

    <!-- MOBILE & TABLET TOGGLE ICON BUTTON (< 1024px) -->
    <div class="flex lg:hidden items-center">
      <button
        type="button"
        id="mobile-menu-toggle-btn"
        aria-label="Toggle Navigation Menu"
        aria-expanded="false"
        aria-controls="mobile-tablet-nav-drawer"
        class="w-12 h-12 rounded-2xl bg-[#166BF3] dark:bg-[#ECB051] text-white dark:text-[#0B1528] border-2 border-[#ECB051] dark:border-[#166BF3] shadow-md flex items-center justify-center transition-transform active:scale-95 focus:outline-none focus-visible:ring-2 focus-visible:ring-[#166BF3]"
      >
        <!-- Hamburger Icon -->
        <svg id="mobile-menu-icon-open" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="3" y1="6" x2="21" y2="6" />
          <line x1="3" y1="12" x2="21" y2="12" />
          <line x1="3" y1="18" x2="21" y2="18" />
        </svg>
        <!-- Close (X) Icon -->
        <svg id="mobile-menu-icon-close" class="hidden w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18" />
          <line x1="6" y1="6" x2="18" y2="18" />
        </svg>
      </button>
    </div>
  </div>

  <!-- COLLAPSIBLE MOBILE & TABLET NAVIGATION DRAWER (< 1024px) -->
  <div
    id="mobile-tablet-nav-drawer"
    class="hidden lg:hidden border-t-2 border-[#166BF3]/25 dark:border-[#ECB051]/30 bg-[#FFFFFF] dark:bg-[#13223E] px-4 pt-4 pb-6 shadow-2xl space-y-4"
  >
    <!-- Row 1: Theme Toggle + Install App Action Buttons -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
      <button
        type="button"
        id="mobile-theme-toggle-btn"
        aria-label={t('nav.theme')}
        class="w-full py-3 px-4 rounded-2xl bg-[#E1E8F4] dark:bg-[#182B4E] text-[#0B1528] dark:text-[#E1E8F4] border-2 border-[#166BF3]/40 dark:border-[#ECB051]/40 flex items-center justify-between font-extrabold text-sm transition-all"
      >
        <span class="flex items-center gap-2.5">
          <svg class="hidden dark:block w-5 h-5 text-[#ECB051]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="5" />
            <line x1="12" y1="1" x2="12" y2="3" />
            <line x1="12" y1="21" x2="12" y2="23" />
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" />
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />
            <line x1="1" y1="12" x2="3" y2="12" />
            <line x1="21" y1="12" x2="23" y2="12" />
          </svg>
          <svg class="block dark:hidden w-5 h-5 text-[#166BF3]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
          </svg>
          <span>{t('nav.theme')}</span>
        </span>
        <span class="px-2 py-0.5 rounded-lg text-xs bg-white dark:bg-[#0B1528] text-[#166BF3] dark:text-[#ECB051]">
          Light / Dark
        </span>
      </button>

      <button
        type="button"
        id="mobile-install-pwa-btn"
        aria-label={t('nav.installPwa')}
        class="w-full py-3 px-4 rounded-2xl bg-[#F2E2CA] dark:bg-[#182B4E] text-[#0B1528] dark:text-[#E1E8F4] border-2 border-[#166BF3]/50 dark:border-[#ECB051]/50 flex items-center justify-center gap-2.5 font-extrabold text-sm transition-all"
      >
        <svg class="w-5 h-5 text-[#166BF3] dark:text-[#ECB051] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="5" y="2" width="14" height="20" rx="2" ry="2" />
          <line x1="12" y1="18" x2="12.01" y2="18" />
          <path d="M12 7v6m0 0l-2.5-2.5M12 13l2.5-2.5" />
        </svg>
        <span>{t('nav.installPwa')}</span>
      </button>
    </div>

    <!-- Row 2: 8-Language Selector Grid -->
    <div class="p-3.5 rounded-2xl bg-[#E1E8F4]/55 dark:bg-[#182B4E] border border-[#166BF3]/30 dark:border-[#ECB051]/30">
      <p class="text-xs font-extrabold uppercase tracking-wider text-[#166BF3] dark:text-[#ECB051] mb-2.5 flex items-center gap-1.5">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="10" />
          <line x1="2" y1="12" x2="22" y2="12" />
          <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
        </svg>
        <span>{t('nav.language')}</span>
      </p>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
        {Object.entries(languages).map(([code, info]) => {
          const targetUrl = getLocalizedPath(code as Locale, '');
          const isActive = code === lang;
          return (
            <a
              href={targetUrl}
              class={`flex items-center justify-between px-3 py-2 rounded-xl text-xs font-extrabold transition-colors ${
                isActive
                  ? 'bg-[#166BF3] text-white dark:bg-[#ECB051] dark:text-[#0B1528] shadow-sm'
                  : 'bg-white dark:bg-[#13223E] text-[#0B1528] dark:text-[#E1E8F4] hover:bg-[#F2E2CA]'
              }`}
            >
              <span class="flex items-center gap-1.5 truncate">
                <span aria-hidden="true">{info.flag}</span>
                <span class="truncate">{info.name}</span>
              </span>
              <span class="text-[10px] opacity-75 ml-1">{info.code}</span>
            </a>
          );
        })}
      </div>
    </div>

    <!-- Row 3: Support the Developer CTA -->
    <a
      href="https://kisharadilshan.gumroad.com/coffee"
      target="_blank"
      rel="noopener noreferrer"
      aria-label={t('nav.support')}
      class="w-full py-3.5 px-5 rounded-2xl bg-[#ECB051] text-[#0B1528] font-black text-sm sm:text-base border-2 border-[#166BF3] shadow-md flex items-center justify-center gap-2.5 transition-all"
    >
      <svg class="w-5 h-5 text-[#0B1528] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M18 8h1a4 4 0 0 1 0 8h-1" />
        <path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z" />
        <line x1="6" y1="1" x2="6" y2="4" />
        <line x1="10" y1="1" x2="10" y2="4" />
        <line x1="14" y1="1" x2="14" y2="4" />
      </svg>
      <span>{t('nav.support')}</span>
    </a>
  </div>

  <!-- Toast Notification for PWA Install -->
  <div
    id="pwa-toast"
    role="status"
    aria-live="polite"
    class="hidden fixed bottom-5 right-5 max-w-sm bg-[#0B1528] text-[#FFFFFF] border-2 border-[#ECB051] px-4 py-3 rounded-2xl shadow-2xl text-sm font-semibold z-50"
  ></div>
</header>

<script>
  function initHeaderControls() {
    // Desktop Language dropdown
    const langBtn = document.getElementById('lang-dropdown-btn');
    const langMenu = document.getElementById('lang-dropdown-menu');
    const langWrapper = document.getElementById('lang-dropdown-wrapper');

    if (langBtn && langMenu) {
      langBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        const isHidden = langMenu.classList.contains('hidden');
        langMenu.classList.toggle('hidden', !isHidden);
        langBtn.setAttribute('aria-expanded', String(isHidden));
      });

      document.addEventListener('click', (e) => {
        if (langWrapper && !langWrapper.contains(e.target as Node)) {
          langMenu.classList.add('hidden');
          langBtn.setAttribute('aria-expanded', 'false');
        }
      });
    }

    // Mobile & Tablet Toggle Menu
    const mobileMenuBtn = document.getElementById('mobile-menu-toggle-btn');
    const mobileDrawer = document.getElementById('mobile-tablet-nav-drawer');
    const iconOpen = document.getElementById('mobile-menu-icon-open');
    const iconClose = document.getElementById('mobile-menu-icon-close');

    if (mobileMenuBtn && mobileDrawer) {
      mobileMenuBtn.addEventListener('click', () => {
        const isHidden = mobileDrawer.classList.contains('hidden');
        mobileDrawer.classList.toggle('hidden', !isHidden);
        mobileMenuBtn.setAttribute('aria-expanded', String(isHidden));
        iconOpen?.classList.toggle('hidden', isHidden);
        iconClose?.classList.toggle('hidden', !isHidden);
      });
    }

    // Theme toggle (both Desktop & Mobile buttons)
    const toggleTheme = () => {
      const htmlEl = document.documentElement;
      const isDark = htmlEl.classList.toggle('dark');
      try {
        localStorage.setItem('giftomp4-theme', isDark ? 'dark' : 'light');
      } catch {}
    };

    document.getElementById('theme-toggle-btn')?.addEventListener('click', toggleTheme);
    document.getElementById('mobile-theme-toggle-btn')?.addEventListener('click', toggleTheme);

    // PWA Install prompt handling (both Desktop & Mobile buttons)
    let deferredPrompt: any = null;
    const installBtn = document.getElementById('install-pwa-btn');
    const mobileInstallBtn = document.getElementById('mobile-install-pwa-btn');
    const pwaToast = document.getElementById('pwa-toast');

    window.addEventListener('beforeinstallprompt', (e) => {
      e.preventDefault();
      deferredPrompt = e;
    });

    const triggerInstall = async () => {
      if (deferredPrompt) {
        deferredPrompt.prompt();
        await deferredPrompt.userChoice;
        deferredPrompt = null;
      } else if (pwaToast) {
        const msg = installBtn?.getAttribute('data-toast-msg') || 'Add this app to your Home Screen from your browser menu.';
        pwaToast.textContent = msg;
        pwaToast.classList.remove('hidden');
        setTimeout(() => {
          pwaToast.classList.add('hidden');
        }, 4200);
      }
    };

    installBtn?.addEventListener('click', triggerInstall);
    mobileInstallBtn?.addEventListener('click', triggerInstall);
  }

  initHeaderControls();
  document.addEventListener('astro:after-swap', initHeaderControls);
</script>

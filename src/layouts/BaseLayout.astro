---
import '../styles/global.css';
import Header from '../components/Header.astro';
import SchemaJsonLd from '../components/SchemaJsonLd.astro';
import {
  languages,
  useTranslations,
  getLocalizedPath,
  TARGET_META_KEYWORDS,
  type Locale,
} from '../i18n/ui';

interface Props {
  lang: Locale;
  title?: string;
  description?: string;
}

const { lang, title, description } = Astro.props;
const t = useTranslations(lang);

const pageTitle = title || t('site.title');
const pageDesc = description || t('site.description');
const canonicalPath = getLocalizedPath(lang, '');
const canonicalURL = new URL(
  canonicalPath.endsWith('/') ? canonicalPath : `${canonicalPath}/`,
  'https://giftomp4.github.io'
).toString();
const ogImageUrl = 'https://giftomp4.github.io/og-image.svg';
const currentOgLocale = languages[lang].ogLocale;
const alternateOgLocales = Object.entries(languages)
  .filter(([code]) => code !== lang)
  .map(([, info]) => info.ogLocale);
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <!-- Google Tag Manager (GTM-TJ3WDZP6) & Google Analytics 4 (G-0YXS1M2VX2) -->
    <script async src="https://www.googletagmanager.com/gtm.js?id=GTM-TJ3WDZP6"></script>
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-0YXS1M2VX2"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-0YXS1M2VX2');
    </script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <meta name="keywords" content={TARGET_META_KEYWORDS} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />

    <!-- Canonical & Sitemap Discovery -->
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" type="application/xml" title="Sitemap" href="https://giftomp4.github.io/sitemap.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="192x192" href="/icon-192.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#166BF3" />

    <!-- 8-Language Hreflang Network + x-default -->
    {Object.keys(languages).map((code) => {
      const p = getLocalizedPath(code as Locale, '');
      const altUrl = new URL(p.endsWith('/') ? p : `${p}/`, 'https://giftomp4.github.io').toString();
      return <link rel="alternate" hreflang={code} href={altUrl} />;
    })}
    <link rel="alternate" hreflang="x-default" href="https://giftomp4.github.io/" />

    <!-- Open Graph Metadata -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content="GIFtoMP4" />
    <meta property="og:locale" content={currentOgLocale} />
    {alternateOgLocales.map((altLoc) => (
      <meta property="og:locale:alternate" content={altLoc} />
    ))}

    <!-- Twitter Cards Metadata -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDesc} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Strict Zero-Fake-Rating Structured Data JSON-LD -->
    <SchemaJsonLd lang={lang} />

    <!-- Anti-FOUC Theme Initialization (Light Mode Default #E1E8F4) -->
    <script is:inline>
      (function () {
        try {
          const saved = localStorage.getItem('giftomp4-theme');
          if (saved === 'dark') {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="min-h-[100dvh] flex flex-col selection:bg-[#ECB051] selection:text-[#0B1528]">
    <Header lang={lang} />
    <main class="flex-1">
      <slot />
    </main>
    <footer class="w-full py-8 px-4 text-center text-xs font-bold text-[#0B1528]/75 dark:text-[#E1E8F4]/75 border-t border-[#166BF3]/20 dark:border-[#ECB051]/20">
      <div class="max-w-5xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-3">
        <p>© {new Date().getFullYear()} GIFtoMP4 — {t('progress.badge')}</p>
        <div class="flex items-center gap-4">
          <a href="/sitemap.xml" class="hover:text-[#166BF3] dark:hover:text-[#ECB051] underline">Sitemap XML</a>
          <a href="https://kisharadilshan.gumroad.com/coffee" target="_blank" rel="noopener noreferrer" class="hover:text-[#166BF3] dark:hover:text-[#ECB051] underline">
            {t('nav.support')}
          </a>
        </div>
      </div>
    </footer>

    <!-- Offline-First PWA Service Worker Registration -->
    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', function () {
          navigator.serviceWorker.register('/sw.js').catch(function () {});
        });
      }
    </script>
  </body>
</html>
